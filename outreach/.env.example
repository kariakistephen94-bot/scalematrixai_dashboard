# Run `npm run init` to create or top up .env with fresh random secrets.

# --- Service ---
PORT=3200
HOST=127.0.0.1
# Used by the dashboard's server-side proxy (OUTREACH_API_TOKEN in frontend/.env.local).
DASHBOARD_TOKEN=
DB_FILE=./data/outreach.db

# --- Lead source: the dashboard's own Google Maps scraper (FastAPI backend, port 8001) ---
# This service never calls Google. It asks the scraper to run Quick Searches for Solar businesses in Abuja and
# Lagos, then imports what it saved. The backend must be running (node scripts/dev.mjs from the dashboard root).
SCRAPER_URL=http://127.0.0.1:8001
# Same value as DASHBOARD_API_TOKEN in backend/.env. `npm run init` fills it in.
SCRAPER_TOKEN=
# Each scraper run saves up to 15 new leads, so 150 a day needs about 10 runs.
SCRAPER_MAX_RUNS_PER_DAY=14
# Discovery pauses while the AI Agent's automatic owner research (OpenAI) is switched on, because it would run
# for every search. Turn it off on the dashboard's AI Agent page, or set this to true to run searches anyway.
SCRAPER_ALLOW_AI_RESEARCH=false
DAILY_LEAD_TARGET=150
# Share of the daily target that should come from Abuja (rest comes from Lagos)
ABUJA_SHARE=0.5
MIN_REVIEW_COUNT=20
# 0 = no rating filter. Set 4.0 to only keep well-rated businesses.
MIN_RATING=0
# Automatic daily discovery starts at this hour, Lagos time
SCAN_START_HOUR=5

# --- WhatsApp accounts (up to 6: A-F). One gateway per account, ports 3101-3106. ---
# Set ACCOUNT_COUNT to the number you want active (1-6), then restart `npm run gateways` and `npm run start`.
ACCOUNT_COUNT=2
GATEWAY_DIR=../../whatsapp-gateway
# Optional: ACCOUNT_A_LABEL=Sales line, ACCOUNT_A_URL=http://127.0.0.1:3101
ACCOUNT_A_LABEL=Account A
ACCOUNT_A_API_KEY=
ACCOUNT_A_STATUS_SECRET=
ACCOUNT_A_INBOUND_SECRET=

ACCOUNT_B_LABEL=Account B
ACCOUNT_B_API_KEY=
ACCOUNT_B_STATUS_SECRET=
ACCOUNT_B_INBOUND_SECRET=

ACCOUNT_C_LABEL=Account C
ACCOUNT_C_API_KEY=
ACCOUNT_C_STATUS_SECRET=
ACCOUNT_C_INBOUND_SECRET=

ACCOUNT_D_LABEL=Account D
ACCOUNT_D_API_KEY=
ACCOUNT_D_STATUS_SECRET=
ACCOUNT_D_INBOUND_SECRET=

ACCOUNT_E_LABEL=Account E
ACCOUNT_E_API_KEY=
ACCOUNT_E_STATUS_SECRET=
ACCOUNT_E_INBOUND_SECRET=

ACCOUNT_F_LABEL=Account F
ACCOUNT_F_API_KEY=
ACCOUNT_F_STATUS_SECRET=
ACCOUNT_F_INBOUND_SECRET=

# --- Sending (starts PAUSED; press Resume in the dashboard when ready) ---
# Lagos time. Days: 0=Sun ... 6=Sat
SEND_WINDOW=09:00-17:30
SEND_DAYS=1-6
# New numbers are warmed up: day 1 sends WARMUP_START, each later day adds WARMUP_STEP, up to the cap
DAILY_CAP_PER_ACCOUNT=75
WARMUP_START=25
WARMUP_STEP=10
# Gap between sends is spread over the window with random jitter, within these bounds
GAP_MIN_SECONDS=60
GAP_MAX_SECONDS=900
# Follow-ups, in days after the first message. Empty = no follow-ups.
FOLLOWUP_DAYS=3,7

# Optional: added to the intro line of messages ("This is Amaka from Company.")
SENDER_NAME=
COMPANY_NAME=
