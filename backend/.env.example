OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Must match frontend/.env.local. The setup script generates this automatically.
DASHBOARD_API_TOKEN=
SCHEDULER_ENABLED=true
TIMEZONE=America/Los_Angeles
GENERATION_TIME=08:00
TARGET_INDUSTRY=Commercial cleaning; Solar businesses; Facility management
TARGET_LOCATION=United States; United Kingdom; Nigeria; China
DAILY_PROSPECT_COUNT=5

# Server-only Google Places API (New) key. Enable this API and billing in Google Cloud.
GOOGLE_MAPS_API_KEY=
# Per discovery job, excluding bounded retries.
GOOGLE_MAPS_MAX_REQUESTS=12
GOOGLE_MAPS_MAX_PAGES=2
